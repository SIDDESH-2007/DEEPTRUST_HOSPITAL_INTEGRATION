# Hospital application URLs allowed as OAuth callbacks (comma-separated).
APP_URL=http://localhost:5176
DEEPTRUST_ALLOWED_REDIRECT_URIS=http://localhost:5176,http://127.0.0.1:5176

# DeepTrust tenant integration. Keep the client secret in .env only.
DEEPTRUST_CLIENT_ID=replace_with_hospital_client_id
DEEPTRUST_CLIENT_SECRET=replace_with_hospital_client_secret
DEEPTRUST_ORGANIZATION_ID=replace_with_hospital_organization_id
DEEPTRUST_ORGANIZATION_NAME=NovaCare Medical Center
DEEPTRUST_API_URL=http://127.0.0.1:8000
DEEPTRUST_GATEWAY_URL=http://127.0.0.1:5000

# Direct patient login uses a scrypt hash formatted as <salt>:<hex digest>.
PATIENT_AUTH_EMAIL=replace_with_patient_email
PATIENT_AUTH_PASSWORD_HASH=replace_with_scrypt_hash
PATIENT_AUTH_NAME=Patient
PATIENT_AUTH_ID=replace_with_patient_id

MONGODB_URI=mongodb://localhost:27017/HospitalIntegrationForDT
PORT=3001
